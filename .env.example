# Base URL of the Bugzilla instance (no trailing slash)
BUGZILLA_BASE_URL=https://bugzilla.example.com

# API key generated in Bugzilla under Preferences -> API Keys
BUGZILLA_API_KEY=your-bugzilla-api-key

# Optional bearer token required on /mcp and /cron endpoints.
# Leave empty to disable auth (not recommended for network-exposed deployments).
MCP_AUTH_TOKEN=

# Cron schedule for the Bugzilla ping job (default: daily at 09:00 UTC)
CRON_SCHEDULE=0 9 * * *

# Port the Express server listens on
PORT=3000

# Optional webhook the cron job POSTs bug.created / bug.changed events to
WEBHOOK_URL=

# Optional HMAC-SHA256 key; adds an X-Webhook-Signature header to webhook posts
WEBHOOK_SECRET=

# JSON file persisting the cron watermark and settings-page overrides
STATE_FILE=.bugzilla-mcp-state.json
